# 翻譯表
# ---------------------------------------------------------------------------
def strings_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (
        os.path.join(here, "strings", "zh-Hant.strings"),
        os.path.join(here, "..", "share", "fcitx5-vanguard", "settings", "zh-Hant.strings"),
        "/usr/share/fcitx5-vanguard/settings/zh-Hant.strings",
    ):
        if os.path.exists(candidate):
            return candidate
    return None


def load_strings():
    """讀 Apple 的 .strings 格式：每行 "key" = "value"; 值裡有 \\n、\\"、\\\\ 的跳脫。"""
    path = strings_path()
    if not path:
        return {}
    table = {}
    pattern = re.compile(r'^"((?:[^"\\]|\\.)*)"\s*=\s*"((?:[^"\\]|\\.)*)";', re.M)
    unescape = lambda text: re.sub(r"\\(.)", lambda m: {"n": "\n", "t": "\t"}.get(m.group(1), m.group(1)), text)
    with open(path, encoding="utf-8") as handle:
        for match in pattern.finditer(handle.read()):
            table[unescape(match.group(1))] = unescape(match.group(2))
    return table


class Texts:
    def __init__(self):
        self.table = load_strings()

    def lookup(self, key):
        """翻譯表有就回傳翻譯；沒有而且是 i18n key 就回傳 None；其餘（數字等）原樣回傳。"""
        if not key:
            return None
        if key in self.table:
            # 本專案不使用原專案的產品名稱。
            return PRODUCT_NAME_PATTERN.sub("本輸入法", self.table[key])
        return None if key.startswith("i18n:") else key

    def title(self, item):
        if item["key"] in EXTRA_TEXTS:
            return EXTRA_TEXTS[item["key"]][0]
        title = self.lookup(item.get("texts", {}).get("title"))
        return (title or item["key"]).rstrip(":：").strip()

    def description(self, item):
        if item["key"] in EXTRA_TEXTS:
            return EXTRA_TEXTS[item["key"]][1]
        texts = item.get("texts", {})
        parts = [self.lookup(texts.get(name)) for name in ("description", "prompt", "inlinePrompt", "toolTip")]
        seen = []
        for part in parts:
            if part and part not in seen:
                seen.append(part)
        return "\n".join(seen)

    def options(self, item):
        """[(引擎的值, 顯示文字)]；沒有固定選項就回傳 None。"""
        if item["key"] in EXTRA_OPTIONS:
            return EXTRA_OPTIONS[item["key"]]
        options = item.get("options")
        if not options:
            return None
        labelled = [(option["value"], self.lookup(str(option["label"]))) for option in options]
        # 標籤就是數字本身的（字級之類）當成數值欄位，不做成選單。
        if all(label is None or label == str(value) for value, label in labelled):
            return None
        return [(value, label or str(value)) for value, label in labelled]


# ---------------------------------------------------------------------------
# 跟 fcitx5 裡的引擎溝通
# ---------------------------------------------------------------------------
class EngineError(Exception):
    pass


WRITE_ERRORS = {1: "引擎不認得這一項", 2: "格式不對", 3: "超出允許的範圍"}


def to_text(item_type, value):
    """把值轉成引擎的 vg_pref_set 接受的字串。"""
    if item_type == "bool":
        return "true" if value else "false"
    if item_type in ("array", "dict"):
        return json.dumps(value, ensure_ascii=False)
    return str(value)


class Engine:
    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error as error:
            raise EngineError(f"連不上 session bus：{error.message}")

    def _call(self, method, parameters, reply_type):
        try:
            return self.bus.call_sync(
                "org.fcitx.Fcitx5", "/controller", "org.fcitx.Fcitx.Controller1", method,
                parameters, reply_type, Gio.DBusCallFlags.NONE, 5000, None)
        except GLib.Error as error:
            message = error.message or ""
            if "ServiceUnknown" in message or "not provided by any" in message or "NameHasNoOwner" in message:
                raise EngineError("fcitx5 沒有在執行。設定存在 fcitx5 行程裡，請先啟動 fcitx5。")
            raise EngineError("fcitx5 有在執行，但拿不到這個外掛的設定。最常見的原因是外掛更新之後 fcitx5 還沒重新啟動，"
                              f"載入的還是舊版；請重新啟動 fcitx5 再試。（fcitx5 的回應：{message}）")

    def read(self):
        """回傳 (全部設定的清單, 使用者資料夾)。"""
        reply = self._call("GetConfig", GLib.Variant("(s)", (CONFIG_URI,)), GLib.VariantType("(va(sa(sssva{sv})))"))
        values = reply.unpack()[0]
        if not isinstance(values, dict) or "Json" not in values:
            raise EngineError("外掛沒有提供設定清單。請確認 fcitx5 已經重新啟動、載入的是新版外掛。")
        self.last_errors = values.get("Errors", "")
        return json.loads(values["Json"]), values.get("UserDataDir", "")

    def write(self, key, text):
        """寫一項。成功回傳 None，被引擎拒絕回傳原因。"""
        payload = GLib.Variant("a{sv}", {key: GLib.Variant("s", text)})
        self._call("SetConfig", GLib.Variant("(sv)", (CONFIG_URI, payload)), None)
        self.read()
        for entry in filter(None, self.last_errors.split(";")):
            name, _, code = entry.rpartition("=")
            if name == key:
                return WRITE_ERRORS.get(int(code), f"錯誤 {code}")
        return None


