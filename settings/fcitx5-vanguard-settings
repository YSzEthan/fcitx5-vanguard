def page_of():
    return {key: page_id for page_id, _title, _intro, keys in PAGES for key in keys}


def status_of(key):
    return "已驗證" if key in VERIFIED else "未驗證"


def command_check(items, texts):
    """分頁表、翻譯表跟引擎實際的設定對不對得起來。"""
    pages = page_of()
    engine_keys = [item["key"] for item in items]
    problems = []
    problems += [f"引擎有、分頁表與隱藏清單都沒有：{key}" for key in engine_keys if key not in pages and key not in HIDDEN]
    problems += [f"分頁表有、引擎沒有：{key}" for key in pages if key not in engine_keys]
    problems += [f"隱藏清單有、引擎沒有：{key}" for key in HIDDEN if key not in engine_keys]
    listed = [key for _id, _title, _intro, keys in PAGES for key in keys] + HIDDEN
    problems += [f"分頁表重複：{key}" for key in sorted(set(listed)) if listed.count(key) > 1]
    for item in items:
        if item["key"] not in EXTRA_TEXTS and not texts.lookup(item.get("texts", {}).get("title")):
            problems.append(f"沒有標題：{item['key']}")
        for option in item.get("options", []):
            if str(option["label"]).startswith("i18n:") and texts.lookup(option["label"]) is None:
                problems.append(f"選項沒有翻譯：{item['key']} = {option['value']}")
    print(f"引擎的設定 {len(engine_keys)} 項：顯示 {len(listed) - len(HIDDEN)} 項、隱藏（這個版本無作用）{len(HIDDEN)} 項；"
          f"翻譯表 {len(texts.table)} 條")
    for problem in problems:
        print("  " + problem)
    print("結果：" + ("PASS" if not problems else f"FAIL（{len(problems)} 個問題）"))
    return 0 if not problems else 1


def run_command_line(arguments):
    engine = Engine()
    items, _folder = engine.read()
    by_key = {item["key"]: item for item in items}
    texts = Texts()
    if arguments.check:
        return command_check(items, texts)
    if arguments.list:
        pages = page_of()
        titles = {page_id: title for page_id, title, _intro, _keys in PAGES}
        for item in items:
            if item["key"] in HIDDEN:
                continue
            page = titles.get(pages.get(item["key"]), "？")
            print(f"{page}\t{status_of(item['key'])}\t{item['key']}\t{to_text(item['type'], item['value'])}\t{texts.title(item)}")
        return 0
    if arguments.get:
        if arguments.get not in by_key:
            print(f"引擎沒有這一項：{arguments.get}", file=sys.stderr)
            return 1
        item = by_key[arguments.get]
        print(to_text(item["type"], item["value"]))
        return 0
    if arguments.set:
        key, separator, value = arguments.set.partition("=")
        if not separator:
            print("格式是 KEY=VALUE", file=sys.stderr)
            return 2
        problem = engine.write(key, value)
        if problem:
            print(f"{key}：{problem}", file=sys.stderr)
            return 1
        return 0
    return None


# ---------------------------------------------------------------------------
# 視窗
# ---------------------------------------------------------------------------
STYLE = """
.vg-row { padding: 10px 14px; }
.vg-title { font-weight: 600; }
.vg-description { font-size: 0.9em; opacity: 0.72; }
.vg-key { font-size: 0.78em; opacity: 0.45; font-family: monospace; }
.vg-badge { font-size: 0.78em; padding: 1px 7px; border-radius: 9px; }
.vg-badge-ok { background: alpha(@theme_selected_bg_color, 0.22); }
.vg-banner { padding: 10px 14px; background: alpha(#c0392b, 0.18); }
.vg-intro { opacity: 0.8; }
.vg-status { padding: 4px 12px; font-size: 0.88em; opacity: 0.75; }
"""


def run_window(arguments):
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, Gtk

    texts = Texts()

    class Row:
        """一項設定在畫面上的一列，以及它的控制元件。"""

        def __init__(self, window, item, verified):
            self.window = window
            self.item = item
            self.key = item["key"]
            self.type = item["type"]
            self.loading = False
            self.search_text = " ".join([self.key, texts.title(item), texts.description(item)]).lower()

            self.widget = Gtk.ListBoxRow(activatable=False, selectable=False)
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
            box.add_css_class("vg-row")
            self.widget.set_child(box)

            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True, valign=Gtk.Align.CENTER)
            heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            title = Gtk.Label(label=texts.title(item), xalign=0, wrap=True)
            title.add_css_class("vg-title")
            heading.append(title)
            if verified:
                heading.append(self.badge(Gtk, "已驗證", "vg-badge-ok"))
            left.append(heading)
            description = texts.description(item)
            if description:
                label = Gtk.Label(label=description, xalign=0, wrap=True, selectable=False)
                label.add_css_class("vg-description")
                left.append(label)
            key_label = Gtk.Label(label=self.key, xalign=0, selectable=True)
            key_label.add_css_class("vg-key")
            left.append(key_label)
            box.append(left)

            right = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, valign=Gtk.Align.CENTER)
            self.options = texts.options(item)
            self.control = self.build_control(Gtk)
            right.append(self.control)
            self.reset = Gtk.Button(icon_name="edit-undo-symbolic", tooltip_text="回到預設值", has_frame=False)
            self.reset.connect("clicked", lambda _button: self.apply(self.item["default"]))
            right.append(self.reset)
            box.append(right)
            self.show_value(item["value"])

        @staticmethod
        def badge(Gtk, text, css_class):
            label = Gtk.Label(label=text, valign=Gtk.Align.CENTER)
            label.add_css_class("vg-badge")
            label.add_css_class(css_class)
            return label

        def option_value(self, raw):
            """引擎宣告成布林、但選項是 0／1 的那幾項，值要換算。"""
            if self.type == "bool":
                return bool(raw)
            return raw

        def build_control(self, Gtk):
            if self.options:
                self.kind = "dropdown"
                control = Gtk.DropDown.new_from_strings([label for _value, label in self.options])
                control.set_size_request(260, -1)
                control.connect("notify::selected", self.on_dropdown)
                return control
            if self.type == "bool":
                self.kind = "switch"
                control = Gtk.Switch(valign=Gtk.Align.CENTER)
                control.connect("notify::active", lambda switch, _spec: self.changed(switch.get_active()))
                return control
            if self.type in ("int", "double"):
                self.kind = "spin"
                low = self.item.get("min", -1_000_000)
                high = self.item.get("max", 1_000_000)
                control = Gtk.SpinButton.new_with_range(low, high, 1)
                control.set_digits(0 if self.type == "int" else 2)
                control.connect("value-changed", self.on_spin)
                return control
            self.kind = "entry"
            if self.key in FILE_KEYS:
                return self.build_file_control(Gtk)
            control = Gtk.Entry(width_chars=28)
            if self.type in ("array", "dict"):
                control.set_tooltip_text("JSON 格式。按 Enter 套用。")
            else:
                control.set_tooltip_text("按 Enter 套用。")
            control.connect("activate", self.on_entry)
            return control

        def build_file_control(self, Gtk):
            """路徑類的設定：文字欄位加一顆選檔案的按鈕。"""
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            self.entry = Gtk.Entry(width_chars=28, tooltip_text="按 Enter 套用。")
            self.entry.connect("activate", self.on_entry)
            box.append(self.entry)
            browse = Gtk.Button(label="選擇檔案…")
            browse.connect("clicked", self.on_browse, Gtk)
            box.append(browse)
            return box

        def on_browse(self, _button, Gtk):
            dialog = Gtk.FileDialog(title=texts.title(self.item))

            def finished(source, result):
                try:
                    chosen = source.open_finish(result)
                except GLib.Error:
                    return  # 使用者按了取消
                self.changed(chosen.get_path())

            dialog.open(self.window, None, finished)

        def on_dropdown(self, dropdown, _spec):
            index = dropdown.get_selected()
            if 0 <= index < len(self.options):
                self.changed(self.option_value(self.options[index][0]))

        def on_spin(self, spin):
            self.changed(spin.get_value_as_int() if self.type == "int" else spin.get_value())

        def on_entry(self, entry):
            text = entry.get_text()
            if self.type in ("array", "dict"):
                try:
                    value = json.loads(text)
                except ValueError:
                    self.window.say(f"「{texts.title(self.item)}」不是合法的 JSON，沒有套用。")
                    self.show_value(self.item["value"])
                    return
            else:
                value = text
            self.changed(value)

        def changed(self, value):
            if not self.loading and value != self.item["value"]:
                self.apply(value)

        def apply(self, value):
            self.window.write(self, value)

        def show_value(self, value):
            """把引擎回報的值畫上去（不觸發寫入）。"""
            self.item["value"] = value
            self.loading = True
            if self.kind == "dropdown":
                index = next((i for i, (raw, _label) in enumerate(self.options) if self.option_value(raw) == value), None)
                # 目前的值不在選項裡時不選任何一個，免得看起來像是別的值。
                self.control.set_selected(index if index is not None else 0xFFFFFFFF)
            elif self.kind == "switch":
                self.control.set_active(bool(value))
            elif self.kind == "spin":
                self.control.set_value(value)
            else:
                entry = getattr(self, "entry", self.control)
                entry.set_text(to_text(self.type, value) if self.type in ("array", "dict") else str(value))
            self.loading = False
            self.reset.set_sensitive(value != self.item["default"])

    class Window(Gtk.ApplicationWindow):
        def __init__(self, application):
            super().__init__(application=application, title=WINDOW_TITLE)
            self.set_default_size(1000, 700)
            self.engine = None
            self.rows = {}
            self.lists = []

            provider = Gtk.CssProvider()
            provider.load_from_data(STYLE.encode())
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

            header = Gtk.HeaderBar()
            self.search = Gtk.SearchEntry(placeholder_text="搜尋設定", width_chars=26)
            self.search.connect("search-changed", self.on_search)
            header.pack_end(self.search)
            reload_button = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="重新讀取")
            reload_button.connect("clicked", lambda _button: self.reload())
            header.pack_start(reload_button)
            self.set_titlebar(header)

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.set_child(outer)

            self.banner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12, visible=False)
            self.banner.add_css_class("vg-banner")
            self.banner_label = Gtk.Label(xalign=0, wrap=True, hexpand=True)
            self.banner.append(self.banner_label)
            retry = Gtk.Button(label="重試")
            retry.connect("clicked", lambda _button: self.reload())
            self.banner.append(retry)
            outer.append(self.banner)

            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, vexpand=True)
            self.stack = Gtk.Stack(hexpand=True)
            sidebar = Gtk.StackSidebar(stack=self.stack)
            sidebar.set_size_request(170, -1)
            body.append(sidebar)
            body.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
            body.append(self.stack)
            outer.append(body)

            outer.append(Gtk.Separator())
            self.status = Gtk.Label(xalign=0, wrap=True)
            self.status.add_css_class("vg-status")
            outer.append(self.status)

            self.reload()

        def say(self, message):
            self.status.set_label(message)

        def fail(self, message):
            self.banner_label.set_label(message)
            self.banner.set_visible(True)

        def reload(self):
            """重新向引擎要全部的設定。第一次會把頁面建出來，之後只更新數值。"""
            try:
                self.engine = self.engine or Engine()
                items, folder = self.engine.read()
            except EngineError as error:
                self.fail(str(error))
                self.say("沒有連上引擎。")
                return False
            self.banner.set_visible(False)
            if not self.rows:
                self.build_pages(items, folder)
            else:
                for item in items:
                    if item["key"] in self.rows:
                        self.rows[item["key"]].show_value(item["value"])
            self.say(f"已連上引擎，共 {len(self.rows)} 項設定。改動會立刻生效並存檔。")
            return True

        def build_pages(self, items, folder):
            by_key = {item["key"]: item for item in items}
            pages = [(page_id, title, intro, [key for key in keys if key in by_key])
                     for page_id, title, intro, keys in PAGES]
            # 引擎之後新增、分頁表還不認得的設定，集中放在最後一頁，不會漏掉。
            leftovers = [item["key"] for item in items if item["key"] not in page_of() and item["key"] not in HIDDEN]
            if leftovers:
                pages.append(("other", "其他", "引擎有、這個設定程式還沒有分類的設定。", leftovers))

            for page_id, title, intro, keys in pages:
                content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                                  margin_top=18, margin_bottom=18, margin_start=22, margin_end=22)
                intro_label = Gtk.Label(label=intro, xalign=0, wrap=True)
                intro_label.add_css_class("vg-intro")
                content.append(intro_label)

                listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, show_separators=True)
                listbox.add_css_class("frame")
                listbox.set_filter_func(self.filter_row)
                for key in keys:
                    row = Row(self, by_key[key], key in VERIFIED)
                    row.widget.vg_row = row
                    self.rows[key] = row
                    listbox.append(row.widget)
                self.lists.append(listbox)
                content.append(listbox)

                if page_id == "lexicon":
                    content.append(self.folder_section(folder))

                scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
                scroller.set_child(content)
                self.stack.add_titled(scroller, page_id, f"{title}（{len(keys)}）")

        def folder_section(self, folder):
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            label = Gtk.Label(xalign=0, wrap=True, hexpand=True, selectable=True,
                              label=f"使用者語彙與選字記憶存放的資料夾：\n{folder or '（引擎沒有回報）'}\n"
                                    "用別的編輯器改了裡面的檔案，要重新啟動 fcitx5 才會生效。")
            label.add_css_class("vg-description")
            box.append(label)
            button = Gtk.Button(label="開啟資料夾", valign=Gtk.Align.CENTER, sensitive=bool(folder))
            button.connect("clicked", lambda _button: subprocess.Popen(["xdg-open", folder]))
            box.append(button)
            return box

        def filter_row(self, list_row):
            needle = self.search.get_text().strip().lower()
            return not needle or needle in list_row.vg_row.search_text

        def on_search(self, _entry):
            for listbox in self.lists:
                listbox.invalidate_filter()

        def write(self, row, value):
            try:
                problem = self.engine.write(row.key, to_text(row.type, value))
                items, _folder = self.engine.read()
            except EngineError as error:
                self.fail(str(error))
                row.show_value(row.item["value"])
                return
            # 引擎可能會把不合理的值改掉，或連帶調整別項，所以整份重讀。
            for item in items:
                if item["key"] in self.rows:
                    self.rows[item["key"]].show_value(item["value"])
            title = texts.title(row.item)
            if problem:
                self.say(f"「{title}」沒有套用：{problem}。")
            elif row.key == "CassetteEnabled" and value and not row.item["value"]:
                self.say("磁帶檔讀不到，引擎把磁帶模式關掉了。請先在上面指定磁帶檔案路徑。")
            elif row.item["value"] != value:
                self.say(f"「{title}」的值被引擎改成 {to_text(row.type, row.item['value'])}（送出的值不被接受）。")
            else:
                self.say(f"已套用「{title}」。")

    class Application(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE if arguments.self_test else 0)
            self.exit_code = 0

        def do_activate(self):
            window = self.props.active_window or Window(self)
            window.present()
            if arguments.self_test:
                GLib.timeout_add(600, self.finish_self_test, window)

        def finish_self_test(self, window):
            """不需要人看的檢查：視窗建得起來、每一項設定都有一列。"""
            total = len(window.engine.read()[0]) if window.engine and window.rows else 0
            expected = total - len(HIDDEN) if total else 0
            print(f"視窗建立：{len(window.rows)} 列（引擎 {total} 項，其中 {len(HIDDEN)} 項無作用不顯示），分頁 {len(window.lists)} 頁")
            ok = expected > 0 and len(window.rows) == expected
            if ok and arguments.screenshot:
                # 畫不出來不算失敗：有些顯示後端沒有畫面可以擷取。
                self.screenshot(window, arguments.screenshot)
            print("結果：" + ("PASS" if ok else "FAIL"))
            self.exit_code = 0 if ok else 1
            self.quit()
            return False

        @staticmethod
        def screenshot(window, prefix):
            """把每一頁畫成 PNG，方便不在螢幕前也能檢查版面。"""
            page_ids = [page_id for page_id, _t, _i, _k in PAGES]
            renderer = window.get_native().get_renderer()
            for page_id in page_ids:
                window.stack.set_visible_child_name(page_id)
                context = GLib.MainContext.default()
                for _ in range(200):
                    context.iteration(False)
                target = window.get_child()
                width, height = target.get_width() or 1000, target.get_height() or 660
                paintable = Gtk.WidgetPaintable.new(target)
                snapshot = Gtk.Snapshot()
                paintable.snapshot(snapshot, width, height)
                node = snapshot.to_node()
                if node is None or renderer is None:
                    print(f"畫不出畫面（{width}x{height}，這個顯示後端不支援）")
                    return False
                renderer.render_texture(node, None).save_to_png(f"{prefix}-{page_id}.png")
            print(f"畫面存到 {prefix}-*.png")
            return True

    application = Application()
    application.run(None)
    return application.exit_code


def main():
    parser = argparse.ArgumentParser(description="fcitx5-vanguard 設定程式")
    parser.add_argument("--list", action="store_true", help="列出全部設定與目前的值")
    parser.add_argument("--get", metavar="KEY", help="讀一項")
    parser.add_argument("--set", metavar="KEY=VALUE", help="寫一項")
    parser.add_argument("--check", action="store_true", help="檢查分頁表與翻譯表有沒有漏")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--screenshot", metavar="PREFIX", help=argparse.SUPPRESS)
    arguments = parser.parse_args()

    if arguments.list or arguments.get or arguments.set or arguments.check:
        try:
            return run_command_line(arguments)
        except EngineError as error:
            print(str(error), file=sys.stderr)
            return 1
    return run_window(arguments)


if __name__ == "__main__":
    sys.exit(main())
